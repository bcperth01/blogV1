<!DOCTYPE html>
<html lang="en">
  <head><%- include('../components/head') %> 
    <title>Users</title>
  </head>
  <body>
    <!-- container for header -->
    <div class="container"><%- include('../components/header') %></div>
      <!-- container for users Table -->
      <div class="container pt-5 mt-5">
        <table class="table table-striped table-hover">
           <tr>
              <th>#</th>
              <th>id</th>
              <th>username</th>
              <th>first_name</th>
              <th>last_name</th>
              <th>email</th>
              <th>member_type</th>
              <th>Actions</th>
           </tr>
           <% users.forEach(function(user,index){%>
            <tr>
              <td><%=index+1%></td>
              <td><%=user.id%></td>
              <td><%=user.username%></td>
              <td><%=user.first_name%></td>          
              <td><%=user.last_name%></td>
              <td><%=user.email%></td>
              <td><%=user.member_type%></td>
              <td>              
                <a href="#" class ="btn btn-dark">
                  <i class="bi bi-pencil"></i>
                </a>
                <a href="#" class ="btn btn-danger">
                  <i class="bi bi-trash"></i>
                </a>
              </td>
            </tr>
           <% }) %>
         </table>
      </div>
    </div>
  </body>
</html>