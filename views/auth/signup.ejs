<!DOCTYPE html>
<html lang="en">
  <head><%- include('../components/head') %> 
    <title>Register</title>
  </head>
  <body>
    <!-- container for header -->
    <div class="container"><%- include('../components/header') %></div>
    <!-- container for page -->
    <div class="container pt-5 mt-5">
      <!-- One outer row - whose contents will be centered-->
      <div class="row justify-content-center">
        <!-- Inner fixed width row with border -->
        <div
          style="width: 450px"
          class="border border-primary border-3 rounded-5 bg-light m1"
        >
          <!-- inner div to contain the form -->
          <div
            style="
              padding-top: 30px;
              padding-bottom: 30px;
              padding-right: 40px;
              padding-left: 30px;
            "
          >
            <!-- every row will have 2 columns with the first column 30px and the second 320px -->
            <div class="row mb-3">
              <div style="width: 45px"></div>
              <h2 class="col text-center">Register New User</h2>
            </div>
            <!-- This is the form -->
            <form class="flex" action="/auth/signup" method="post">
              <!-- First Name -->
              <section class="row mb-2">
                <label style="width: 45px" for="first_name"
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-person"
                    viewBox="0 0 16 16"
                  >
                    <path
                      d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"
                    />
                  </svg>
                </label>
                <input
                  class="col"
                  id="first_name"
                  name="first_name"
                  type="text"
                  autocomplete="first_name"
                  placeholder="First Name"
                  value="<%=form.first_name ||''%>"
                />
              </section>
              <!-- Last Name -->
              <section class="row mb-2">
                <label style="width: 45px" for="last_name"
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-person"
                    viewBox="0 0 16 16"
                  >
                    <path
                      d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"
                    />
                  </svg>
                </label>
                <input
                  class="col"
                  id="last_name"
                  name="last_name"
                  type="text"
                  autocomplete="last_name"
                  placeholder="Last Name"
                  value="<%=form.last_name || ''%>"
                />
              </section>
              <!-- Email -->
              <section class="row mb-2">
                <label style="width: 45px" for="email">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-envelope"
                    viewBox="0 0 16 16"
                  >
                    <path
                      d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"
                    />
                  </svg>
                </label>
                <input
                  class="col"
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="Email *"
                  required
                  value="<%=form.email || ''%>"
                />
              </section>
              <!-- Member Type (Role) -->
              <section class="row mb-2">
                <label style="width: 45px" for="member-type"
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-tools"
                    viewBox="0 0 16 16"
                  >
                    <path
                      d="M1 0 0 1l2.2 3.081a1 1 0 0 0 .815.419h.07a1 1 0 0 1 .708.293l2.675 2.675-2.617 2.654A3.003 3.003 0 0 0 0 13a3 3 0 1 0 5.878-.851l2.654-2.617.968.968-.305.914a1 1 0 0 0 .242 1.023l3.27 3.27a.997.997 0 0 0 1.414 0l1.586-1.586a.997.997 0 0 0 0-1.414l-3.27-3.27a1 1 0 0 0-1.023-.242L10.5 9.5l-.96-.96 2.68-2.643A3.005 3.005 0 0 0 16 3q0-.405-.102-.777l-2.14 2.141L12 4l-.364-1.757L13.777.102a3 3 0 0 0-3.675 3.68L7.462 6.46 4.793 3.793a1 1 0 0 1-.293-.707v-.071a1 1 0 0 0-.419-.814zm9.646 10.646a.5.5 0 0 1 .708 0l2.914 2.915a.5.5 0 0 1-.707.707l-2.915-2.914a.5.5 0 0 1 0-.708M3 11l.471.242.529.026.287.445.445.287.026.529L5 13l-.242.471-.026.529-.445.287-.287.445-.529.026L3 15l-.471-.242L2 14.732l-.287-.445L1.268 14l-.026-.529L1 13l.242-.471.026-.529.445-.287.287-.445.529-.026z"
                    />
                  </svg>
                </label>
                <select class="col" name="member_type" id="member_type">
                  <option value="public">Public</option>
                  <option value="user">User</option>
                  <option value="admin">Admin</option>
                </select>
              </section>
              <!-- Username (for login) -->
              <section class="row mb-2">
                <label style="width: 45px" for="username"
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-person-workspace"
                    viewBox="0 0 16 16"
                  >
                    <path
                      d="M4 16s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-5.95a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"
                    />
                    <path
                      d="M2 1a2 2 0 0 0-2 2v9.5A1.5 1.5 0 0 0 1.5 14h.653a5.4 5.4 0 0 1 1.066-2H1V3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v9h-2.219c.554.654.89 1.373 1.066 2h.653a1.5 1.5 0 0 0 1.5-1.5V3a2 2 0 0 0-2-2z"
                    />
                  </svg>
                </label>
                <input
                  class="col"
                  id="username"
                  name="username"
                  type="username"
                  autocomplete="username"
                  placeholder="Username *"
                  required
                  value="<%=form.username%>"
                />
              </section>
              <!-- Password -->
              <section class="row mb-2">
                <label style="width: 45px" for="password"
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-lock"
                    viewBox="0 0 16 16"
                  >
                    <path
                      d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2M5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1"
                    />
                  </svg>
                </label>
                <input
                  class="col"
                  id="password"
                  name="password"
                  type="password"
                  autocomplete="password"
                  placeholder="Password *"
                  required
                  value="<%=form.password  || ''%>"
                />
              </section>
              <!-- Confirm Password -->
              <section class="row mb-2">
                <label style="width: 45px" for="confirm_password"
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-lock"
                    viewBox="0 0 16 16"
                  >
                    <path
                      d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2M5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1"
                    />
                  </svg>
                </label>
                <input
                  class="col ml-1"
                  id="confirm_password"
                  name="confirm_password"
                  type="password"
                  autocomplete="new_password"
                  placeholder="Confirm Password *"
                  required
                  value="<%=form.confirm_password || ''%>"
                />
              </section>
              <% if (err_msg !== "") { %>
              <section class="row">
                <div style="width: 45px"></div>
                <div class="col text-danger">
                  <small><%= err_msg %></small>
                </div>
              </section>
              <% } %>
              <section class="row mb-2 pt-1">
                <div style="width: 45px"></div>
                <button class="col btn btn-primary" type="submit">
                  Sign up
                </button>
              </section>
              <section class="row">
                <div style="width: 45px"></div>
                <div class="col">
                  Already have a login?<span class="px-3"
                    ><a href="/auth/login">Login</a></span
                  >
                </div>
              </section>
            </form>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
