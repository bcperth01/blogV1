<!DOCTYPE html>
<html lang="en">
  <head><%- include('../components/head') %> 
    <% if(type === "new") { %>
      <title>Register</title>
    <% } else { %>
      <title>Edit User</title>
    <% } %>
  </head>
  <body>
    <!-- container for header -->
    <div class="container"><%- include('../components/header') %></div>
    <% if(res.loggedIn && (res.member_type === "member" ||
    res.member_type === "admin")) {%>
    <!-- container for page -->
      <div class="container pt-4 mt-4">
    <%} else { %>
      <div class="container pt-5 mt-5"></div>
    <%} %>
      <!-- One outer row - whose contents will be centered-->
      <div class="row justify-content-center">
        <!-- Inner fixed width row with border -->
        <div
          style="width: 500px"
          class="border border-primary border-3 rounded-5 bg-light m1"
        >
          <!-- inner div to contain the form -->
          <div
            style="
              padding-top: 30px;
              padding-bottom: 30px;
              padding-right: 40px;
              padding-left: 30px;
            "
          >
            <!-- every row will have 2 columns with the first column 30px and the second 320px -->
            <div class="row mb-3">
              <% if(type === "new") { %>
                <h2 class="col text-center">Register New User</h2>
              <%} else if(type === "edit")  { %>
                <h2 class="col text-center">Edit Existing User</h2>
              <%} else {%>
                <h2 class="col text-center">Edit User Profile
              <%} %>
            </div>
            <!-- This is the form (Note: "action" attribute is in the submit buttons below)-->
            <!-- Note: Buttons below have "formaction" and "formmethod" attributes-->
            <form class="flex">
              <!-- Show the user id when editing an existing user-->
              <% if(type !== "new") { %>
                <section class="row mb-2">
                  <label style="width: 80px; text-align: right;" for="id">
                    id
                  </label>
                  <input
                    class="col"
                    style="background-color: lightgray;"
                    id="id"
                    name="id"
                    readonly
                    value="<%=form1.id ||''%>"
                  />
                </section>
              <% } %>
              <!-- First Name -->
              <section class="row mb-2">
                <label style="width: 80px; text-align: right;" for="first_name">
                  F Name
                </label>
                <input
                  class="col"
                  id="first_name"
                  name="first_name"
                  type="text"
                  autocomplete="first_name"
                  placeholder="First Name"
                  value="<%=form1.first_name ||''%>"
                />
              </section>
              <!-- Last Name -->
              <section class="row mb-2">
                <label style="width: 80px; text-align: right;" for="last_name">
                  L Name
                </label>
                <input
                  class="col"
                  id="last_name"
                  name="last_name"
                  type="text"
                  autocomplete="last_name"
                  placeholder="Last Name"
                  value="<%=form1.last_name || ''%>"
                />
              </section>
              <!-- Email -->
              <section class="row mb-2">
                <label style="width: 80px; text-align: right;" for="email">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-envelope"
                    viewBox="0 0 16 16"
                  >
                    <path
                      d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"
                    />
                  </svg>
                </label>
                <input
                  class="col"
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="Email *"
                  required
                  value="<%=form1.email || ''%>"
                  <%= type !== "new"  ? 'readonly' : '' %>
                  style = "<%= type !== "new"  ? "background-color: lightgray;" : "" %>"
                />
              </section>
              <% if(res.loggedIn && (res.member_type === "member" ||
              res.member_type === "admin")) {%>
                <!-- Member Type (Role) -->
                <section class="row mb-2">
                  <label style="width: 80px; text-align: right;" for="member-type">
                    Role
                  </label>
                  <select class="col" name="member_type" id="member_type">
                    <% if(type !== "new") { %>
                      <option value="public" <%= form1.member_type==="public" ? 'selected' : '' %>    >Public</option>
                      <option value="user" <%= form1.member_type==="user" ? 'selected' : '' %>>User</option>
                      <option value="admin" <%= form1.member_type==="admin" ? 'selected' : '' %> >Admin</option>
                    <% } else { %>
                      <option value="public" selected >Public</option>
                      <option value="user">User</option>
                      <option value="admin">Admin</option>
                    <% } %>
                  </select>
                </section>
                <!-- verified (verified|unverified|pending)-->
                <section class="row mb-2">
                  <label style="width: 80px; text-align: right;" for="member-type">
                    Verified
                  </label>
                  <select class="col" name="verified" id="verified">
                    <% if(type !== "new") { %>
                      <option value="unverified" <%= form1.verified ==="unverified" ? 'selected' : '' %> >Unverified</option>
                      <option value="verified" <%= form1.verified==="verified" ? 'selected' : '' %> >Verified</option>
                      <option value="pending" <%= form1.verified==="pending" ? 'selected' : '' %> >Pending</option>
                    <% } else { %>
                      <option value="unverified" selected>Unverified</option>
                      <option value="verified">Verified</option>
                      <option value="pending">Pending</option>
                    <% } %>
                  </select>
                </section>
                <!-- Status (active|suspended|pending)-->
                <section class="row mb-2">
                  <label style="width: 80px; text-align: right;" for="member-type">
                    Status
                  </label>
                  <select class="col" name="status" id="status">
                    <% if(type !== "new") { %>
                      <option value="active" <%= form1.status ==="active" ? 'selected' : '' %> >Active</option>
                      <option value="suspended <%= form1.status ==="suspended" ? 'selected' : '' %> ">Suspended</option>
                      <option value="pending" <%= form1.status ==="pending" ? 'selected' : '' %> >Pending</option>
                    <% } else { %>
                      <option value="active">Active</option>
                      <option value="suspended">Suspended</option>
                      <option value="pending" selected ="selected">Pending</option>
                    <% } %>
                  </select>
                </section>
              <% } %>
              <!-- Username (for login) -->
              <section class="row mb-2">
                <label style="width: 80px; text-align: right;" for="username"
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-person-workspace"
                    viewBox="0 0 16 16"
                  >
                    <path
                      d="M4 16s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-5.95a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"
                    />
                    <path
                      d="M2 1a2 2 0 0 0-2 2v9.5A1.5 1.5 0 0 0 1.5 14h.653a5.4 5.4 0 0 1 1.066-2H1V3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v9h-2.219c.554.654.89 1.373 1.066 2h.653a1.5 1.5 0 0 0 1.5-1.5V3a2 2 0 0 0-2-2z"
                    />
                  </svg>
                </label>
                <% if(form1.username && form1.username.length > 1) { %>
                 <input
                    class="col"
                    id="username"
                    name="username"
                    type="text"
                    placeholder="Username *"
                    required
                    value="<%=form1.username%>"
                    <%= type !== "new"  ? 'readonly' : '' %> 
                    style = "<%= type !== "new"  ? "background-color: lightgray;" : "" %>"
                />
                <% } else { %>
                  <input
                    class="col"
                    id="username"
                    name="username"
                    type="text"
                    placeholder="Username *"
                    value = "-"
                    required
                  />
                <% } %>
              </section>
              <!-- Password -->
              <section class="row mb-2">
                <label style="width: 80px; text-align: right;" for="password"
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-lock"
                    viewBox="0 0 16 16"
                  >
                    <path
                      d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2M5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1"
                    />
                  </svg>
                </label>
                <input
                  class="col"
                  id="password"
                  name="password"
                  type="password"
                  autocomplete="password"
                  placeholder="Password *"
                  value=""
                />
              </section>
              <!-- Confirm Password -->
              <section class="row mb-2">
                <label style="width: 80px; text-align: right;" for="confirm_password"
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-lock"
                    viewBox="0 0 16 16"
                  >
                    <path
                      d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2M5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1"
                    />
                  </svg>
                </label>
                <input
                  class="col ml-1"
                  id="confirm_password"
                  name="confirm_password"
                  type="password"
                  placeholder="Confirm Password *"
                  value=""
                />
              </section>
              <% if (err_msg !== "") { %>
              <section class="row">
                <div style="width: 80px; text-align: right;"></div>
                <div class="col text-danger">
                  <small><%= err_msg %></small>
                </div>
              </section>
              <% } %>
              <section class="d-flex flex-row mb-1 gap-2 justify-content-between">
                <div style="width: 75px"></div>
                  <% if(type==="new") { %>
                    <button class="btn btn-primary flex-fill" type="submit" formaction = "/auth/signup" formmethod = "post">Sign up</button>
                  <% } else { %>
                    <button class="btn btn-primary flex-fill" type="submit" formaction = "/auth/edit" formmethod = "post">Save Changes</button> 
                  <% } %>
                </button>
                <button class="btn btn-outline-primary flex-fill" type="submit" formnovalidate formaction = "/auth/cancel" formmethod = "get">
                  Cancel
                </button>
              </section>
              <% if(!res.loggedIn) { %>
                <section class="row">
                  <div style="width: 80px; text-align: right;"></div>
                  <div class="col">
                    Already have a login?<span class="px-3"><a href="/auth/login">Login</a></span>
                  </div>
                </section>
              <% } %>
            </form>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
