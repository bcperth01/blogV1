<!-- See here https://getbootstrap.com/docs/5.3/components/navbar/ for how to create nav bars with Bookstrap -->
<!-- src="https://dev.w3.org/SVG/tools/svgweb/samples/svg-files/bozo.svg" -->
<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" href="/"
      ><img src="/images/logo.svg" alt="Logo" width="30" height="24"
    /></a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/articles/home"
            >Home</a
          >
        </li>
        <li class="nav-item">
          <a class="nav-link" aria-current="page" href="/about">About</a>
        </li>
        <li class="nav-item">
          <a
            class="nav-link"
            aria-current="page"
            href="/articles?filter=published"
            >Articles</a
          >
        </li>
        <!-- Only show this if we are on the routes shown -->
        <% if (path.startsWith("/articles")) { %>
        <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle"
            data-bs-auto-close="outside"
            href="#"
            role="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            File
          </a>
          <ul class="dropdown-menu">
            <% if (path.startsWith("/articles/display/")) { %>
                <li>
                  <a class="dropdown-item" href="/articles/edit/<%= path.replace("/articles/display/", "") %>">Edit</a>
               </li>
               <li>
                  <a class="dropdown-item text-danger" href="#" id="menuDelete" data-path="<%= path %>">
                      Delete
                  </a>
               </li>
            <% } %>
            <li>
              <a class="dropdown-item" href="/articles/new">New Article</a>
            </li>
            <li>
              <a class="dropdown-item" href="#" id="menuSave">Save</a>
            </li>
            <li>
              <a class="dropdown-item" href="/manageImages/listImages2"
                >Exit Without Saving</a
              >
            </li>
          </ul>
        </li>
        <% } %> <% if (res.loggedIn && res.member_type === "admin") { %>
        <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle"
            data-bs-auto-close="outside"
            href="#"
            role="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            Admin
          </a>
          <ul class="dropdown-menu">
            <li>
              <a class="dropdown-item" href="/auth/manageUsers">Manage Users</a>
            </li>
            <li>
              <a class="dropdown-item" href="/manageImages/listImages2"
                >Manage Images</a
              >
            </li>
            <li>
              <a class="dropdown-item" href="/admin/comments"
                >Manage Comments</a
              >
            </li>
            <li>
              <a class="dropdown-item" href="/admin/documents"
                >Manage Documents</a
              >
            </li>
            <li>
              <a class="dropdown-item" href="/admin/backups">Manage Backups</a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li class="nav-item dropend">
              <a
                class="dropdown-item dropdown-toggle"
                data-bs-toggle="dropdown"
                href="#"
                >Spare</a
              >
              <ul class="dropdown-menu">
                <li><a href="#" class="dropdown-item">Item 1</a></li>
                <li><a href="#" class="dropdown-item">Item 2</a></li>
                <li><a href="#" class="dropdown-item">Item 3</a></li>
              </ul>
            </li>
          </ul>
        </li>
       <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle"
            data-bs-auto-close="outside"
            href="#"
            role="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            Help
          </a>
          <ul class="dropdown-menu">
          <% if (path.startsWith("/manageImages")) { %>
            <li>
              <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#ImagesHelpModal">Managing Images</a>
            </li>
          <% } %>
          <% if (path.startsWith("/articles/edit/")) { %>
            <li>
              <a class="dropdown-item" href="/#">Editing Articles</a>
            </li>
          <% } %>
          <% if (path.startsWith("/articles")) { %>
            <li>
              <a class="dropdown-item" href="/#">About Articles</a>
            </li>
          <% } %>
            <li>
              <a class="dropdown-item" href="/#"" data-bs-toggle="modal" data-bs-target="#SiteHelpModal">Site Help</a>
            </li>
          </ul>
        </li>
        <% } %> <% if (res.loggedIn && res.member_type !== "admin") { %>
        <li class="nav-item">
          <a class="nav-link" aria-current="page" href="/auth/editProfile"
            >Edit Profile</a
          >
        </li>
        <% } %>
      </ul>
      <!-- Only show this if we are on the articles route -->
      <% if (path === '/articles') { %>
      <form
        class="d-flex"
        role="search"
        action="/articles/search"
        method="post"
      >
        <input
          class="form-control me-2"
          type="search"
          placeholder="Search for articles..."
          aria-label="Search"
          name="searchCriteria"
        />
        <button class="btn btn-outline-success" type="submit">Search</button>
      </form>
      <% } %>
      <!-- end conditional on articles route  -->
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        <% if (res.loggedIn) { %>
        <li class="nav-item mt-2">[user: <%=res.username%>]</li>
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/auth/logout"
            >Logout</a
          >
        </li>
        <% } else { %>
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/auth/login"
            >Login</a
          >
        </li>
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/auth/signup"
            >Sign up</a
          >
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>



