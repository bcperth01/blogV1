<!-- Fits between <head> tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
  integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
  crossorigin="anonymous"
/>
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
/>
<link rel="stylesheet" href="/css/styles.css" />
<!-- Link to custom css file -->
<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"
></script>
<link type="text/css" href="/styles/github-dark.min.css" rel="stylesheet" />
<style>
  /* for the right click MD editor custom menu */
  .custom-menu {
    display: none;
    position: absolute;
    z-index: 10000;
    width: 260px;
    padding: 0;
    border-radius: 6px;
    background: white;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial;
  }

  /* menu items */
  .custom-menu .list-group-item {
    padding: 8px 12px;
    cursor: pointer;
    user-select: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .custom-menu .list-group-item:hover {
    background: #f6f7f8;
  }

  /* submenus */
  .has-submenu {
    position: relative;
  }
  .submenu {
    display: none;
    position: absolute;
    left: 100%;
    top: 0;
    min-width: 220px;
    background: white;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    border-radius: 6px;
    padding: 4px 0;
  }
  .has-submenu:hover > .submenu {
    display: block;
  }

  /* submenu item */
  .submenu-item {
    padding: 8px 12px;
    white-space: nowrap;
    cursor: pointer;
  }
  .submenu-item:hover {
    background: #eef2f5;
  }

  /* cancel */
  .list-group-item.text-danger {
    color: #c82333;
  }

  /* auto-resize textarea */
  textarea.auto-resize {
    overflow-y: hidden;
    transition: height 0.12s ease;
  }

  /* For the article cards */
  .article-card-wrapper {
    width: 250px; /* ← set your fixed card width */
    flex: 0 0 auto; /* prevents shrinking */
  }
  .description-ellipsis {
    display: -webkit-box;
    -webkit-line-clamp: 3; /* Number of lines to show */
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Tooltip container */
  .tooltip {
    position: relative;
    display: inline-block;
    border-bottom: 1px dotted black; /* If you want dots under the hoverable text */
  }

  /* Tooltip text */
  .tooltip .tooltiptext {
    visibility: hidden;
    width: 120px;
    background-color: black;
    color: #fff;
    text-align: center;
    padding: 5px 0;
    border-radius: 6px;

    /* Position the tooltip text - see examples below! */
    position: absolute;
    z-index: 1;
  }

  /* Show the tooltip text when you mouse over the tooltip container */
  .tooltip:hover .tooltiptext {
    visibility: visible;
  }
</style>
