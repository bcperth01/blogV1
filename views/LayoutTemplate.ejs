<!--COPY AND PASTE THIS WHEN CREATEING A NEW ROUTE-->
<!--COPY IN ADDITIONAL SEACHBAR PARTIAL IF NEEDED-->
<!--COPY IN ROUTE PARTIAL -->
<!--EXAMPLE SHOWN FOR THE listImages route -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../components/head') %>
    <!-- The title is supplied by the express route that sets res.locals.title = "route title"-->
    <title><%= title || "BC Blog" %></title>
  </head>
  <body>
    <div class="container">
      <!-- wrapper to make the navbars sticky-->
      <div class="sticky-stack sticky-top">
        <!-- The header is the navbar -->
        <%- include('../components/header') %>
        <!-- Put additonal search bars (that need to be sticky) here for the route here-->
        <!-- COPY IN WHERE NEEDED ...The searchbar for images-->
        <%- include('../partials/images/imagesSearchBar') %>
      </div>
      <!-- ADD IN route specific HTML, modals and scripts here -->
      <%- include('../partials/images/listImagesCode') %>
    </div>
    <!-- This Help modal is available to all routes-->
    <%- include('../partials/siteHelpModal') %>
  </body>
</html>
