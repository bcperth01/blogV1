<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../components/head') %>
    <title>List Images</title>
    <style>
      .card img {
        object-fit: cover;
        height: 150px;
      }
    </style>
  </head>
  <body>
    <!-- Loading Overlay -->
    <div id="loading-overlay">
      <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
    </div>

    <style>
      #loading-overlay {
        position: fixed;
        inset: 0;
        background: rgba(255, 255, 255, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999; /* above everything */
      }
    </style>

    <!-- container for header -->
    <div class="container"><%- include('../components/header') %></div>

    <div class="container mt-5">
      <h1 class="mb-4 text-center">Images (in S3)</h1>

      <% if (images.length === 0) { %>
      <div class="alert alert-warning text-center">
        No Images Found In the Bucket
      </div>
      <% } else { %>
      <!-- Bootstrap Table -->
      <table
        class="table table-bordered table-hover align-middle shadow-sm bg-white"
      >
        <thead class="table-light">
          <tr>
            <th style="width: 120px">Thumbnail</th>
            <th>Image Name</th>
            <th>Actions</th>
            <th>Copy</th>
          </tr>
        </thead>
        <tbody>
          <% images.forEach(image => { const safeKey =
          image.key.replace(/[^a-zA-Z0-9_-]/g, '-'); %>

          <tr id="img-<%= safeKey %>">
            <td>
              <img
                src="<%= image.url %>"
                width="120"
                class="img-thumbnail clickable-thumb"
                data-key="<%= image.key %>"
              />
            </td>

            <td><%= image.key.replace(/^thumbnails\//, '') %></td>

            <td>
              <!-- Rotate Right -->
              <form
                action="/manageImages/rotate-image"
                method="POST"
                style="display: inline"
              >
                <input type="hidden" name="key" value="<%= image.key %>" />
                <input type="hidden" name="focusKey" value="<%= safeKey %>" />
                <input type="hidden" name="direction" value="right" />
                <button
                  type="submit"
                  class="btn btn-outline-primary btn-sm"
                  title="Rotate Right"
                >
                  <i class="bi bi-arrow-clockwise"></i>
                </button>
              </form>

              <!-- Rotate Left -->
              <form
                action="/manageImages/rotate-image"
                method="POST"
                style="display: inline"
              >
                <input type="hidden" name="key" value="<%= image.key %>" />
                <input type="hidden" name="focusKey" value="<%= safeKey %>" />
                <input type="hidden" name="direction" value="left" />
                <button
                  type="submit"
                  class="btn btn-outline-primary btn-sm"
                  title="Rotate Left"
                >
                  <i class="bi bi-arrow-counterclockwise"></i>
                </button>
              </form>

              <!-- Delete -->
              <form
                action="/manageImages/delete-image"
                method="POST"
                style="display: inline"
                onsubmit="return confirm('Delete this image?');"
              >
                <input type="hidden" name="key" value="<%= image.key %>" />
                <input type="hidden" name="focusKey" value="<%= safeKey %>" />
                <button
                  type="submit"
                  class="btn btn-outline-danger btn-sm"
                  title="Delete"
                >
                  <i class="bi bi-trash"></i>
                </button>
              </form>
            </td>
            <td>
              <!-- ✅ Select Button -->
              <form
                action="/manageImages/selectImage/<%= encodeURIComponent(image.key.replace(/^thumbnails\//, '')) %>"
                method="POST"
              >
                <button type="submit" class="btn btn-primary btn-sm">
                  Select
                </button>
              </form>
            </td>
          </tr>

          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>

    <!-- Bootstrap Modal -->
    <div
      class="modal fade"
      id="imageModal"
      tabindex="-1"
      aria-labelledby="imageModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="imageModalLabel">Image</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body text-center">
            <img
              id="modalImage"
              src=""
              class="img-fluid rounded"
              style="max-height: 90vh"
              alt=""
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> -->

    <script>
      const modal = new bootstrap.Modal(document.getElementById("imageModal"));
      const modalImage = document.getElementById("modalImage");
      const modalTitle = document.getElementById("imageModalLabel");

      // Add click listener to all thumbnails
      document.querySelectorAll(".clickable-thumb").forEach((img) => {
        img.addEventListener("click", async () => {
          console.log("clicked");
          let key = img.getAttribute("data-key");
          // ✅ Replace 'thumbnails/' prefix with 'images/'
          key = key.replace(/^thumbnails\//, "images/");

          // Call Express endpoint to get full image URL
          const res = await fetch(
            `/manageImages/getImage/${encodeURIComponent(key)}`
          );
          const data = await res.json();

          // Set modal content
          modalImage.src = data.url;
          modalTitle.textContent = key.replace(/^images\//, "");

          // Show modal
          modal.show();
        });
      });
    </script>

    // This code makes sure the list scrolls to the rotated image after a
    rotation refresh
    <script>
      window.addEventListener("load", () => {
        // <-- waits for images and layout
        const params = new URLSearchParams(window.location.search);
        const focus = params.get("focus");

        if (!focus) return;

        const row = document.getElementById(`img-${focus}`);
        if (!row) {
          console.warn("Row not found:", `img-${focus}`);
          return;
        }

        console.log("Scrolling to:", row.id);

        row.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });

        row.style.transition = "background-color 1s";
        row.style.backgroundColor = "#e7f1ff";
        setTimeout(() => (row.style.backgroundColor = ""), 2000);

        // ✅ Remove `focus=...` from the URL *after* scrolling
        params.delete("focus");
        const cleanUrl = `${window.location.pathname}?${params.toString()}`;
        window.history.replaceState({}, "", cleanUrl);
      });
    </script>

    // This code is for the loading indicator
    <script>
      window.addEventListener("load", () => {
        const overlay = document.getElementById("loading-overlay");
        if (overlay) {
          overlay.style.opacity = "0";
          overlay.style.transition = "opacity 0.4s ease";
          setTimeout(() => overlay.remove(), 400);
        }
      });
    </script>
  </body>
</html>
