<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../components/head') %>
    <title>List Images</title>
    <style>
      .card img {
        object-fit: cover;
        height: 150px;
      }
    </style>
  </head>
  <body>
    <!-- container for header -->
    <div class="container"><%- include('../components/header') %></div>

    <div class="container mt-5">
      <h1 class="mb-4 text-center">Thumbnails (in S3)</h1>

      <% if (images.length === 0) { %>
      <div class="alert alert-warning text-center">
        No Images Found In the Bucket
      </div>
      <% } else { %>

      <!-- ✅ Bootstrap Table -->
      <table
        class="table table-bordered table-hover align-middle shadow-sm bg-white"
      >
        <thead class="table-light">
          <tr>
            <th>Image Name</th>
            <th style="width: 120px">Thumbnail</th>
          </tr>
        </thead>
        <tbody>
          <% images.forEach(image => { %>
          <tr>
            <td><%= image.key.replace(/^thumbnails\//, '') %></td>
            <td class="text-center">
              <img
                src="<%= image.url %>"
                alt="<%= image.key %>"
                class="img-fluid rounded"
                style="max-height: 80px"
              />
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>

      <% } %>
    </div>
  </body>
</html>
