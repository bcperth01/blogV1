<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- The head has the CDN includes and the global <style>-->
    <%- include('../components/head') %>
    <title>Images</title>
  </head>
  <body>
    <!-- Loading Overlay with Progress Bar -->
    <div id="loading-overlay">
      <div class="text-center" style="width: 300px">
        <p class="mb-2 fw-bold">Loading thumbnails...</p>
        <div class="progress" style="height: 20px">
          <div
            id="loading-progress"
            class="progress-bar progress-bar-striped progress-bar-animated"
            role="progressbar"
            style="width: 0%"
          ></div>
        </div>
      </div>
    </div>
    <div class="container">
      <!-- wrapper to make the navbars sticky-->
      <div class="sticky-stack sticky-top">
        <!-- The header is the navbar -->
        <%- include('../components/header') %>
        <!-- This is the search bar, info line and upload button-->
        <div
          class="d-flex justify-content-between align-items-center mb-3 pt-2"
        >
          <form
            method="GET"
            action="/manageImages/listImages2"
            class="d-flex"
            role="search"
          >
            <input
              type="text"
              name="filter"
              value="<%= filter || '' %>"
              placeholder="Find images..."
              class="form-control me-2"
            />
            <button class="btn btn-outline-secondary" type="submit">
              Filter
            </button>
          </form>
          <button
            type="button"
            class="btn btn-outline-secondary btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#notesModal"
          >
            About Images
          </button>
          <!-- Upload button -->
          <button
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#uploadModal"
          >
            <i class="bi bi-upload me-1"></i> Upload Image
          </button>
        </div>
      </div>

      <div class="container mt-2">
        <% if (images.length === 0) { %>
        <div class="alert alert-warning text-center">
          No Images Found In the Bucket
        </div>
        <% } else { %>

        <!-- Bootstrap Table -->
        <table
          class="table table-bordered table-hover align-middle shadow-sm bg-white"
        >
          <thead class="table-light">
            <tr>
              <th style="width: 120px">Thumbnail</th>
              <th>Image Name</th>
              <th>Actions</th>
              <th>Copy</th>
            </tr>
          </thead>
          <tbody>
            <% images.forEach(image => { const safeKey =
            image.key.replace(/[^a-zA-Z0-9_-]/g, '-'); %>

            <tr id="img-<%= safeKey %>">
              <td>
                <img
                  src="<%= image.url %>"
                  width="120"
                  class="img-thumbnail clickable-thumb"
                  data-key="<%= image.key %>"
                />
              </td>

              <td><%= image.key.replace(/^thumbnails\//, '') %></td>

              <td>
                <!-- Rotate Right -->
                <form
                  action="/manageImages/rotate-image"
                  method="POST"
                  style="display: inline"
                >
                  <input type="hidden" name="key" value="<%= image.key %>" />
                  <input type="hidden" name="focusKey" value="<%= safeKey %>" />
                  <input type="hidden" name="direction" value="right" />

                  <button
                    type="submit"
                    class="btn btn-outline-primary btn-sm rotate-btn"
                    title="Rotate Right"
                  >
                    <!-- Normal rotate icon -->
                    <i class="bi bi-arrow-clockwise rotate-icon"></i>

                    <!-- Spinner (hidden by default) -->
                    <span
                      class="spinner-border spinner-border-sm rotate-spinner"
                      style="display: none; vertical-align: middle"
                      role="status"
                      aria-hidden="true"
                    ></span>
                  </button>
                </form>

                <!-- Rotate Left -->
                <form
                  action="/manageImages/rotate-image"
                  method="POST"
                  style="display: inline"
                >
                  <input type="hidden" name="key" value="<%= image.key %>" />
                  <input type="hidden" name="focusKey" value="<%= safeKey %>" />
                  <input type="hidden" name="direction" value="left" />
                  <button
                    type="submit"
                    class="btn btn-outline-primary btn-sm rotate-btn"
                    title="Rotate Left"
                  >
                    <!-- Normal rotate icon -->
                    <i class="bi bi-arrow-counterclockwise rotate-icon"></i>

                    <!-- Spinner (hidden by default) -->
                    <span
                      class="spinner-border spinner-border-sm rotate-spinner"
                      style="display: none; vertical-align: middle"
                      role="status"
                      aria-hidden="true"
                    ></span>
                  </button>
                </form>

                <!-- Delete -->
                <form
                  action="/manageImages/delete-image"
                  method="POST"
                  style="display: inline"
                  onsubmit="return confirm('Delete this image?');"
                >
                  <input type="hidden" name="key" value="<%= image.key %>" />
                  <input type="hidden" name="focusKey" value="<%= safeKey %>" />
                  <button
                    type="submit"
                    class="btn btn-outline-danger btn-sm"
                    title="Delete"
                  >
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </td>
              <td>
                <button
                  class="btn btn-sm btn-success copy-btn"
                  data-filename="<%= image.key %>"
                >
                  Select
                </button>
              </td>
            </tr>

            <% }) %>
          </tbody>
        </table>
        <% } %>
      </div>

      <!-- About Images Modal -->
      <div class="modal fade" id="notesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Notes About Images</h5>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
              ></button>
            </div>

            <div class="modal-body">
              <p>
                When you upload an image, its best to upload the highest res you
                have. Three versions will be automatically produced and saved;
                thumbnails, cards and high res.
              </p>

              <ul>
                <li>
                  All images are stored in an AWS S3 bucket and there is no
                  public access.
                </li>
                <li>
                  Images are accessed by the site using short life signed URLs.
                </li>
                <li>Click on a thumbnail to see the high res version.</li>
                <li>
                  Rotating left or right by 90Deg will rotate all versions.
                </li>
                <li>Deleting removes all versions.</li>
                <li>
                  When uploading, the image name you give must not already
                  exist.
                </li>
                <li>Images are converted to jpg when they are uploaded.</li>
                <li>
                  When you Select an image its name goes into the clipboard, for
                  you to embed in a document
                </li>
              </ul>
            </div>

            <div class="modal-footer">
              <button
                type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal"
              >
                Close
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Bootstrap Modal for full image display -->
      <div
        class="modal fade"
        id="imageModal"
        tabindex="-1"
        aria-labelledby="imageModalLabel"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-dialog-centered modal-xl">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="imageModalLabel">Image</h5>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>
            <div class="modal-body text-center">
              <div
                id="panzoom-container"
                style="overflow: hidden; display: inline-block"
              >
                <img
                  id="modalImage"
                  src=""
                  class="img-fluid rounded"
                  style="max-height: 90vh; cursor: grab"
                  alt=""
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Upload Image Modal -->
      <!-- Upload Modal -->
      <div class="modal fade" id="uploadModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Upload New Image</h5>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
              ></button>
            </div>

            <form id="uploadForm" enctype="multipart/form-data">
              <div class="modal-body">
                <!-- Name field -->
                <label class="form-label fw-bold">Image Name</label>
                <input
                  type="text"
                  id="imageName"
                  name="imageName"
                  class="form-control mb-3"
                  required
                />

                <!-- Drag-drop area -->
                <div
                  id="dropArea"
                  class="border border-2 border-secondary rounded p-4 text-center"
                  style="cursor: pointer"
                >
                  <p class="text-muted mb-0">
                    Drag & drop an image here or click to select
                  </p>
                  <input
                    type="file"
                    id="imageFile"
                    name="imageFile"
                    accept="image/*"
                    hidden
                    required
                  />
                </div>

                <!-- Selected file name -->
                <div
                  id="selectedFileInfo"
                  class="mt-2 text-success fw-bold"
                  style="display: none"
                ></div>

                <!-- Thumbnail preview -->
                <div
                  id="thumbnailPreview"
                  class="mt-3 text-center"
                  style="display: none"
                >
                  <img
                    id="previewImage"
                    class="img-thumbnail"
                    style="max-height: 180px"
                  />
                  <br />
                  <button
                    type="button"
                    id="clearFileBtn"
                    class="btn btn-sm btn-outline-danger mt-2"
                  >
                    <i class="bi bi-x-circle"></i> Remove File
                  </button>
                </div>

                <!-- Progress bar -->
                <div class="mt-4" id="progressContainer" style="display: none">
                  <label class="form-label">Uploading...</label>
                  <div class="progress">
                    <div
                      id="uploadProgress"
                      class="progress-bar"
                      role="progressbar"
                      style="width: 0%"
                    ></div>
                  </div>
                </div>
              </div>

              <div class="modal-footer">
                <button
                  type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal"
                >
                  Cancel
                </button>
                <button type="submit" class="btn btn-primary">Upload</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- pan and zoom libraries -->
    <script src="https://cdn.jsdelivr.net/npm/@panzoom/panzoom@4.5.1/dist/panzoom.min.js"></script>

    <script>
      const nav = document.querySelector(".navbar.sticky-top");
      document.documentElement.style.setProperty(
        "--nav-height",
        nav.offsetHeight + "px"
      );
    </script>

    <script>
      const modalElement = document.getElementById("imageModal");
      const modal = new bootstrap.Modal(modalElement);
      const modalImage = document.getElementById("modalImage");
      const modalTitle = document.getElementById("imageModalLabel");
      const panzoomContainer = document.getElementById("panzoom-container");
      let panzoomInstance = null;

      // Add click listener to all thumbnails
      document.querySelectorAll(".clickable-thumb").forEach((img) => {
        img.addEventListener("click", async () => {
          let key = img.getAttribute("data-key");
          key = key.replace(/^thumbnails\//, "images/");

          const res = await fetch(
            `/manageImages/getImage/${encodeURIComponent(key)}`
          );
          const data = await res.json();

          modalImage.src = data.url;
          modalTitle.textContent = key.replace(/^images\//, "");
          modal.show();
        });
      });

      // When modal is shown — initialize Panzoom
      modalElement.addEventListener("shown.bs.modal", () => {
        if (panzoomInstance) {
          panzoomInstance.reset(); // reset previous zoom/pan
        }
        panzoomInstance = Panzoom(modalImage, {
          maxScale: 5,
          minScale: 1,
          contain: "outside",
        });

        // Enable scroll-to-zoom
        panzoomContainer.addEventListener(
          "wheel",
          panzoomInstance.zoomWithWheel
        );
      });

      // When modal is hidden — clean up Panzoom
      modalElement.addEventListener("hidden.bs.modal", () => {
        if (panzoomInstance) {
          panzoomInstance.destroy();
          panzoomInstance = null;
        }
        modalImage.src = ""; // optional: clear image
      });
    </script>

    <!-- This code makes sure the list scrolls to the rotated image after a
    rotation refresh -->
    <script>
      window.addEventListener("load", () => {
        // <-- waits for images and layout
        const params = new URLSearchParams(window.location.search);
        const focus = params.get("focus");

        if (!focus) return;

        const row = document.getElementById(`img-${focus}`);
        if (!row) {
          console.warn("Row not found:", `img-${focus}`);
          return;
        }

        console.log("Scrolling to:", row.id);

        row.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });

        row.style.transition = "background-color 1s";
        row.style.backgroundColor = "#e7f1ff";
        setTimeout(() => (row.style.backgroundColor = ""), 2000);

        // ✅ Remove `focus=...` from the URL *after* scrolling
        params.delete("focus");
        const cleanUrl = `${window.location.pathname}?${params.toString()}`;
        window.history.replaceState({}, "", cleanUrl);
      });
    </script>

    <!-- this is for the progress bar -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const overlay = document.getElementById("loading-overlay");
        const progressBar = document.getElementById("loading-progress");
        const images = document.querySelectorAll("img.img-thumbnail");

        if (images.length === 0) {
          overlay.remove();
          return;
        }

        let loadedCount = 0;

        const updateProgress = () => {
          loadedCount++;
          const percent = Math.round((loadedCount / images.length) * 100);
          progressBar.style.width = percent + "%";
          progressBar.textContent = percent + "%";

          if (loadedCount >= images.length) {
            setTimeout(() => {
              overlay.style.opacity = "0";
              setTimeout(() => overlay.remove(), 400);
            }, 200);
          }
        };

        images.forEach((img) => {
          if (img.complete) {
            updateProgress();
          } else {
            img.addEventListener("load", updateProgress);
            img.addEventListener("error", updateProgress); // count even if an image fails
          }
        });
      });
    </script>

    <!-- this is for the image upload modal-->

    <script>
      const dropArea = document.getElementById("dropArea");
      const fileInput = document.getElementById("imageFile");
      const selectedFileInfo = document.getElementById("selectedFileInfo");
      const thumbnailPreview = document.getElementById("thumbnailPreview");
      const previewImage = document.getElementById("previewImage");
      const clearFileBtn = document.getElementById("clearFileBtn");

      const progressContainer = document.getElementById("progressContainer");
      const progressBar = document.getElementById("uploadProgress");

      const uploadModalEl = document.getElementById("uploadModal");

      function isImageFile(file) {
        return file && file.type.startsWith("image/");
      }

      function showSelectedFile(file) {
        if (!file) return;

        if (!isImageFile(file)) {
          alert("❌ Invalid file type. Please choose an image.");
          clearSelectedFile();
          return;
        }

        dropArea.classList.remove("border-secondary");
        dropArea.classList.add("border-success");

        selectedFileInfo.style.display = "block";
        selectedFileInfo.textContent = "Selected: " + file.name;

        // Thumbnail preview
        const reader = new FileReader();
        reader.onload = (e) => {
          previewImage.src = e.target.result;
          thumbnailPreview.style.display = "block";
        };
        reader.readAsDataURL(file);
      }

      function clearSelectedFile() {
        fileInput.value = "";
        selectedFileInfo.style.display = "none";
        thumbnailPreview.style.display = "none";
        dropArea.classList.remove("border-success");
        dropArea.classList.add("border-secondary");
      }

      // Click = choose file
      dropArea.addEventListener("click", () => fileInput.click());

      // Drag-over
      dropArea.addEventListener("dragover", (e) => {
        e.preventDefault();
        dropArea.classList.add("bg-light");
      });

      dropArea.addEventListener("dragleave", () =>
        dropArea.classList.remove("bg-light")
      );

      // Drop file
      dropArea.addEventListener("drop", (e) => {
        e.preventDefault();
        dropArea.classList.remove("bg-light");

        const file = e.dataTransfer.files[0];
        fileInput.files = e.dataTransfer.files;
        showSelectedFile(file);
      });

      // File picker
      fileInput.addEventListener("change", () => {
        if (fileInput.files.length > 0) {
          showSelectedFile(fileInput.files[0]);
        }
      });

      // Clear file
      clearFileBtn.addEventListener("click", clearSelectedFile);

      // Upload form submit
      document
        .getElementById("uploadForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();

          const name = document.getElementById("imageName").value.trim();
          const file = fileInput.files[0];

          if (!name || !file) {
            alert("Please enter a name and select an image.");
            return;
          }

          const formData = new FormData();
          formData.append("imageName", name);
          formData.append("imageFile", file);

          progressContainer.style.display = "block";

          const xhr = new XMLHttpRequest();
          xhr.open("POST", "/manageImages/uploadImage");

          xhr.upload.addEventListener("progress", (e) => {
            if (e.lengthComputable) {
              const percent = Math.round((e.loaded / e.total) * 100);
              progressBar.style.width = percent + "%";
            }
          });

          xhr.onload = () => {
            if (xhr.status === 200) {
              progressBar.classList.add("bg-success");
              setTimeout(() => location.reload(), 600);
            } else {
              progressBar.classList.add("bg-danger");
              alert("Upload failed.");
            }
          };

          xhr.send(formData);
        });

      // Cleanup when modal closes
      uploadModalEl.addEventListener("hidden.bs.modal", () => {
        clearSelectedFile();
        document.getElementById("imageName").value = "";

        progressBar.style.width = "0%";
        progressBar.classList.remove("bg-danger", "bg-success");
        progressContainer.style.display = "none";
      });
    </script>
    <!-- This script displays a spinner while images are rotating-->
    <script>
      document.querySelectorAll(".rotate-btn").forEach((btn) => {
        btn.addEventListener("click", function (e) {
          e.preventDefault(); // stop auto-submit

          const form = btn.closest("form");
          const icon = btn.querySelector(".rotate-icon");
          const spinner = btn.querySelector(".rotate-spinner");

          // Swap icon → spinner
          btn.disabled = true;
          icon.style.display = "none";
          spinner.style.display = "inline-block";

          // Submit normally
          form.submit();
        });
      });
    </script>
    <!-- This script is to copy the image filename to the clipboard when Select is pressed-->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".copy-btn").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const filename = btn.dataset.filename;

            try {
              await navigator.clipboard.writeText(filename);

              // Optional: give quick feedback
              btn.textContent = "Copied!";
              btn.classList.add("btn-warning");

              setTimeout(() => {
                btn.textContent = "Select";
                btn.classList.remove("btn-warning");
              }, 1200);
            } catch (err) {
              alert("Copy failed. Your browser may block clipboard access.");
            }
          });
        });
      });
    </script>
  </body>
</html>
