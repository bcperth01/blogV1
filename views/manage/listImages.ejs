<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../components/head') %>
    <title>List Images</title>
    <style>
      .card img {
        object-fit: cover;
        height: 150px;
      }
    </style>
  </head>
  <body>
    <!-- Loading Overlay with Progress Bar -->
    <div id="loading-overlay">
      <div class="text-center" style="width: 300px">
        <p class="mb-2 fw-bold">Loading thumbnails...</p>
        <div class="progress" style="height: 20px">
          <div
            id="loading-progress"
            class="progress-bar progress-bar-striped progress-bar-animated"
            role="progressbar"
            style="width: 0%"
          ></div>
        </div>
      </div>
    </div>

    <style>
      #loading-overlay {
        position: fixed;
        inset: 0;
        background: rgba(255, 255, 255, 0.95);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        transition: opacity 0.4s ease;
      }
    </style>

    <!-- container for header -->
    <div class="container"><%- include('../components/header') %></div>

    <div class="container mt-5">
      <h1 class="mb-4 text-center">Images (in S3)</h1>

      <% if (images.length === 0) { %>
      <div class="alert alert-warning text-center">
        No Images Found In the Bucket
      </div>
      <% } else { %>
      <form
        method="GET"
        action="/manageImages/listImages2"
        class="mb-3 d-flex"
        role="search"
      >
        <input
          type="text"
          name="filter"
          value="<%= filter || '' %>"
          placeholder="Filter images..."
          class="form-control me-2"
        />
        <button class="btn btn-outline-secondary" type="submit">Filter</button>
      </form>

      <!-- Bootstrap Table -->
      <table
        class="table table-bordered table-hover align-middle shadow-sm bg-white"
      >
        <thead class="table-light">
          <tr>
            <th style="width: 120px">Thumbnail</th>
            <th>Image Name</th>
            <th>Actions</th>
            <th>Copy</th>
          </tr>
        </thead>
        <tbody>
          <% images.forEach(image => { const safeKey =
          image.key.replace(/[^a-zA-Z0-9_-]/g, '-'); %>

          <tr id="img-<%= safeKey %>">
            <td>
              <img
                src="<%= image.url %>"
                width="120"
                class="img-thumbnail clickable-thumb"
                data-key="<%= image.key %>"
              />
            </td>

            <td><%= image.key.replace(/^thumbnails\//, '') %></td>

            <td>
              <!-- Rotate Right -->
              <form
                action="/manageImages/rotate-image"
                method="POST"
                style="display: inline"
              >
                <input type="hidden" name="key" value="<%= image.key %>" />
                <input type="hidden" name="focusKey" value="<%= safeKey %>" />
                <input type="hidden" name="direction" value="right" />
                <button
                  type="submit"
                  class="btn btn-outline-primary btn-sm"
                  title="Rotate Right"
                >
                  <i class="bi bi-arrow-clockwise"></i>
                </button>
              </form>

              <!-- Rotate Left -->
              <form
                action="/manageImages/rotate-image"
                method="POST"
                style="display: inline"
              >
                <input type="hidden" name="key" value="<%= image.key %>" />
                <input type="hidden" name="focusKey" value="<%= safeKey %>" />
                <input type="hidden" name="direction" value="left" />
                <button
                  type="submit"
                  class="btn btn-outline-primary btn-sm"
                  title="Rotate Left"
                >
                  <i class="bi bi-arrow-counterclockwise"></i>
                </button>
              </form>

              <!-- Delete -->
              <form
                action="/manageImages/delete-image"
                method="POST"
                style="display: inline"
                onsubmit="return confirm('Delete this image?');"
              >
                <input type="hidden" name="key" value="<%= image.key %>" />
                <input type="hidden" name="focusKey" value="<%= safeKey %>" />
                <button
                  type="submit"
                  class="btn btn-outline-danger btn-sm"
                  title="Delete"
                >
                  <i class="bi bi-trash"></i>
                </button>
              </form>
            </td>
            <td>
              <!-- ✅ Select Button -->
              <form
                action="/manageImages/selectImage/<%= encodeURIComponent(image.key.replace(/^thumbnails\//, '')) %>"
                method="POST"
              >
                <button type="submit" class="btn btn-primary btn-sm">
                  Select
                </button>
              </form>
            </td>
          </tr>

          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>

    <!-- Bootstrap Modal -->
    <div
      class="modal fade"
      id="imageModal"
      tabindex="-1"
      aria-labelledby="imageModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="imageModalLabel">Image</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body text-center">
            <div
              id="panzoom-container"
              style="overflow: hidden; display: inline-block"
            >
              <img
                id="modalImage"
                src=""
                class="img-fluid rounded"
                style="max-height: 90vh; cursor: grab"
                alt=""
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> -->
    <script src="https://cdn.jsdelivr.net/npm/@panzoom/panzoom@4.5.1/dist/panzoom.min.js"></script>

    <script>
      const modalElement = document.getElementById("imageModal");
      const modal = new bootstrap.Modal(modalElement);
      const modalImage = document.getElementById("modalImage");
      const modalTitle = document.getElementById("imageModalLabel");
      const panzoomContainer = document.getElementById("panzoom-container");
      let panzoomInstance = null;

      // Add click listener to all thumbnails
      document.querySelectorAll(".clickable-thumb").forEach((img) => {
        img.addEventListener("click", async () => {
          let key = img.getAttribute("data-key");
          key = key.replace(/^thumbnails\//, "images/");

          const res = await fetch(
            `/manageImages/getImage/${encodeURIComponent(key)}`
          );
          const data = await res.json();

          modalImage.src = data.url;
          modalTitle.textContent = key.replace(/^images\//, "");
          modal.show();
        });
      });

      // When modal is shown — initialize Panzoom
      modalElement.addEventListener("shown.bs.modal", () => {
        if (panzoomInstance) {
          panzoomInstance.reset(); // reset previous zoom/pan
        }
        panzoomInstance = Panzoom(modalImage, {
          maxScale: 5,
          minScale: 1,
          contain: "outside",
        });

        // Enable scroll-to-zoom
        panzoomContainer.addEventListener(
          "wheel",
          panzoomInstance.zoomWithWheel
        );
      });

      // When modal is hidden — clean up Panzoom
      modalElement.addEventListener("hidden.bs.modal", () => {
        if (panzoomInstance) {
          panzoomInstance.destroy();
          panzoomInstance = null;
        }
        modalImage.src = ""; // optional: clear image
      });
    </script>

    <!-- This code makes sure the list scrolls to the rotated image after a
    rotation refresh -->
    <script>
      window.addEventListener("load", () => {
        // <-- waits for images and layout
        const params = new URLSearchParams(window.location.search);
        const focus = params.get("focus");

        if (!focus) return;

        const row = document.getElementById(`img-${focus}`);
        if (!row) {
          console.warn("Row not found:", `img-${focus}`);
          return;
        }

        console.log("Scrolling to:", row.id);

        row.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });

        row.style.transition = "background-color 1s";
        row.style.backgroundColor = "#e7f1ff";
        setTimeout(() => (row.style.backgroundColor = ""), 2000);

        // ✅ Remove `focus=...` from the URL *after* scrolling
        params.delete("focus");
        const cleanUrl = `${window.location.pathname}?${params.toString()}`;
        window.history.replaceState({}, "", cleanUrl);
      });
    </script>

    <!-- this is for the progress bar -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const overlay = document.getElementById("loading-overlay");
        const progressBar = document.getElementById("loading-progress");
        const images = document.querySelectorAll("img.img-thumbnail");

        if (images.length === 0) {
          overlay.remove();
          return;
        }

        let loadedCount = 0;

        const updateProgress = () => {
          loadedCount++;
          const percent = Math.round((loadedCount / images.length) * 100);
          progressBar.style.width = percent + "%";
          progressBar.textContent = percent + "%";

          if (loadedCount >= images.length) {
            setTimeout(() => {
              overlay.style.opacity = "0";
              setTimeout(() => overlay.remove(), 400);
            }, 200);
          }
        };

        images.forEach((img) => {
          if (img.complete) {
            updateProgress();
          } else {
            img.addEventListener("load", updateProgress);
            img.addEventListener("error", updateProgress); // count even if an image fails
          }
        });
      });
    </script>
  </body>
</html>
