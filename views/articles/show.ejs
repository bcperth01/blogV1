<!DOCTYPE html>
<html lang="en">
  <head><%- include('../components/head') %> 
    <title>Show</title>
  </head>
  <body>
    <div class="container">
      <%- include('../components/header') %>
      <h1 class="mb-1"><%= article.title %></h1>
      <div class="text-muted mb-2">
        <%= article.created_at.toLocaleDateString() %>
      </div>
      <a href="/articles" class="btn btn-secondary"
        ><%=`<---- Articles List`%></a
      >
      <a href="/articles/edit/<%=article.slug%>" class="btn btn-info">Edit</a>
      <div><%-article.sanitisedHtml%></div>
    </div>
  </body>
</html>
