<!DOCTYPE html>
<html lang="en">
  <head><%- include('../components/head') %> 
    <title>New</title>
  </head>
  <body>
    <div class="container">
      <%- include('../components/header') %>
      <h1 class="mb-4">New Article</h1>
      <form action="/articles" method="POST">
        <%- include('_form_fields') %>
        <div class="mt-3">
          <a href="/" class="btn btn-secondary">Exit Without Save</a>
