<!DOCTYPE html>
<html lang="en">
  <head><%- include('../components/head') %> 
    <title>Edit</title>
  </head>
  <body>
    <div class="container">
      <%- include('../components/header') %>
      <div class="row">
        <div class="col leftside">
          <h1 class="mb-4">Edit Article Form...</h1>
          <form action="/articles/<%= article.id %>?_method=PUT" method="POST">
            <%- include('_form_fields') %>
            <div class="mt-3">
              <a href="/" class="btn btn-secondary">Exit Without Save</a>
              <button
                type="submit"
                class="btn btn-primary"
                name="button"
                value="Save"
              >
                Save
              </button>
            </div>
          </form>
        </div>
        <div class="col rightside">
          <h2 class="mb-4">Preview</h2>
          <div class="border"><%-article.sanitisedHtml%></div>
        </div>
      </div>
    </div>
  </body>
</html>
