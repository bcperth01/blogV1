<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <link type="text/css" href="/styles/github-dark.min.css" rel="stylesheet" />
    <link
      type="text/css"
      href="/styles/editTemplate/style.css"
      rel="stylesheet"
    />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Edit</title>
  </head>
  <body>
    <div class="container">
      <%- include('../components/header') %>
      <div class="row">
        <div class="col leftside">
          <h1 class="mb-4">Edit Article Form...</h1>
          <form action="/articles/<%= article.id %>?_method=PUT" method="POST">
            <%- include('_form_fields') %>
          </form>
        </div>
        <div class="col rightside">
          <h2 class="mb-4">Preview</h2>
          <div class="border"><%-article.sanitisedHtml%></div>
        </div>
      </div>
    </div>
  </body>
</html>
