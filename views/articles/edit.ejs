<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../components/head') %>
    <title>Edit</title>
  </head>
  <body>
    <div class="container">
      <!-- wrapper to make the navbars sticky-->
      <div class="sticky-stack sticky-top">
        <%- include('../components/header') %>
      </div>
      <div class="row">
        <div class="col leftside">
          <h1 class="mb-4">Edit Article Form...</h1>
          <div id="status" style="margin-top: 10px"></div>
          <form id="editForm"><%- include('form_fields2') %></form>
        </div>
        <div class="col rightside">
          <h2 class="mb-4">Preview of Article Body (images shown)</h2>
          <div class="border"><%-article.sanitisedHtml%></div>
        </div>
      </div>
    </div>

    <!-- Custom Context Menu  -->
    <script>
      const textarea = document.getElementById("markdownEditor");
      const menu = document.getElementById("customMenu");

      // auto-resize
      function autoResize(el) {
        el.style.height = "auto";
        el.style.height = el.scrollHeight + "px";
      }
      autoResize(textarea);
      textarea.addEventListener("input", () => autoResize(textarea));

      // show menu at cursor
      textarea.addEventListener("contextmenu", (e) => {
        e.preventDefault();
        menu.style.display = "block";

        // viewport fit
        const rect = menu.getBoundingClientRect();
        const docW = document.documentElement.clientWidth;
        const docH = document.documentElement.clientHeight;
        let left = e.pageX,
          top = e.pageY;
        if (left + rect.width > docW) left = Math.max(8, docW - rect.width - 8);
        if (top + rect.height > docH) top = Math.max(8, docH - rect.height - 8);

        menu.style.left = left + "px";
        menu.style.top = top + "px";
      });

      // hide menu on click outside
      document.addEventListener("mousedown", (e) => {
        if (e.button === 2) return; // ignore right-click
        if (!menu.contains(e.target) && e.target !== textarea) {
          menu.style.display = "none";
        }
      });

      // insert at cursor
      function insertAtCursor(textarea, text) {
        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        textarea.value =
          textarea.value.slice(0, start) + text + textarea.value.slice(end);
        textarea.selectionStart = textarea.selectionEnd = start + text.length;
        textarea.focus();
        autoResize(textarea);
      }

      // handle menu clicks
      menu.addEventListener("click", (e) => {
        const el = e.target.closest("[data-action]");
        if (!el) return;
        const action = el.dataset.action;
        let snippet = "";

        switch (action) {
          case "h1":
            snippet = "# Heading 1\n\n";
            break;
          case "h2":
            snippet = "## Heading 2\n\n";
            res.render("about/about", {
              article,
              res: res.locals,
            });
            break;
          case "bold":
            snippet = "**bold text**";
            break;
          case "italic":
            snippet = "_italic text_";
            break;
          case "inlineCode":
            snippet = "`inline code`";
            break;
          case "codeBlock":
            snippet = "```\n// code here\n```\n\n";
            break;
          case "ulist":
            snippet = "- Item 1\n- Item 2\n- Item 3\n\n";
            break;
          case "olist":
            snippet = "1. First\n2. Second\n3. Third\n\n";
            break;
          case "insertTable":
            snippet =
              "| Column 1 | Column 2 |\n|----------|----------|\n| Value 1  | Value 2  |\n";
            break;
          case "insertImage":
            snippet = "![Alt text](path/to/image.jpg)\n";
            break;
          case "insertLink":
            snippet = "[Link text](https://example.com)\n";
            break;
          case "cancel":
            menu.style.display = "none";
            return;
          default:
            return;
        }

        insertAtCursor(textarea, snippet);
        menu.style.display = "none";
      });
    </script>

    <!-- handling edit changes and saving  -->
    <% if (path.startsWith("/articles")) { %>
    <script>
      const status = document.getElementById("status");
      const saveBtn = document.getElementById("menuSave");

      // 1. SELECT ALL FORM FIELDS
      const fields = Array.from(
        document.querySelectorAll("#editForm input, #editForm textarea")
      );

      // Store initial values
      let originalValues = {};
      fields.forEach((f) => (originalValues[f.id] = f.value));

      let isDirty = false;

      // Warn the user before leaving the page if there are unsaved changes
      window.addEventListener("beforeunload", (e) => {
        if (!isDirty) return; // allow normal navigation if clean

        e.preventDefault();
        e.returnValue = ""; // required for Chrome/Edge/Firefox
      });

      // --- DIRTY STATE DETECTION ---
      fields.forEach((field) => {
        field.addEventListener("input", () => {
          checkDirty();
        });
      });

      function checkDirty() {
        for (const field of fields) {
          if (field.value !== originalValues[field.id]) {
            setDirty(true);
            return;
          }
        }
        setDirty(false);
      }

      function setDirty(state) {
        if (isDirty === state) return;

        isDirty = state;

        if (isDirty) {
          status.style.opacity = 1;
          status.textContent = "Unsaved changes";
          status.style.color = "orange";
        } else {
          status.textContent = "";
        }
      }

      // --- SAVE HANDLER ---
      saveBtn.addEventListener("click", async () => {
        // COLLECT ALL FIELD VALUES INTO AN OBJECT
        const payload = {};
        fields.forEach((f) => (payload[f.name] = f.value));

        console.log("payload", payload);

        saveBtn.disabled = true;
        status.style.opacity = 1;
        status.textContent = "Saving...";
        status.style.color = "black";

        try {
          const res = await fetch("/articles/saveArticle", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            throw new Error(err.message || `Server error`);
          }

          const data = await res.json();
          if (!data.success)
            throw new Error(data.message || "Unknown server error");

          // SUCCESS
          status.textContent = "Saved successfully!";
          status.style.color = "green";

          // close the menu-drop-down
          const dropdownToggle = document.querySelector(
            '.dropdown-toggle.show, .dropdown-toggle[aria-expanded="true"]'
          );
          if (dropdownToggle) {
            const dropdown = bootstrap.Dropdown.getInstance(dropdownToggle);
            dropdown.hide();
          }

          // RESET ORIGINAL VALUES
          fields.forEach((f) => (originalValues[f.id] = f.value));
          isDirty = false;

          // FADE OUT SUCCESS MESSAGE
          setTimeout(() => {
            status.style.transition = "opacity 1s";
            status.style.opacity = 0;
          }, 3000);
        } catch (err) {
          status.textContent = "Error: " + err.message;
          status.style.color = "red";
          status.style.opacity = 1;
        } finally {
          saveBtn.disabled = false;
        }
      });
    </script>

    <% } %>
  </body>
</html>
