<div class="form-group">
  <label for="title">Title</label>
  <input
    required
    value="<%=article.title%>"
    type="text"
    name="title"
    id="title"
    class="form-control"
  />
</div>
<div class="form-group">
  <label for="description">Description</label>
  <textarea
    required
    type="text"
    name="description"
    id="description"
    class="form-control"
  >
 <%=article.description%> 
 </textarea
  >
</div>
<div class="form-group">
  <label for="markdown">Markdown</label>
  <textarea
    required
    type="text"
    name="markdown"
    id="markdown"
    class="form-control"
    rows="20"
  >
 <%=article.markdown%>
 </textarea
  >
</div>
