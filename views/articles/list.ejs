<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../components/head') %>
    <title>Articles</title>
  </head>
  <body>
    <div class="container">
      <%- include('../components/header') %>
      <h1>Matching Articles</h1>
      <p>(Edit documents via the "Articles" menu item)</p>
      <% if (articles.length === 0) {%>
      <h4 class="mt-4"><%=none_msg%></h4>
      <% } else { %>
      <div class="d-flex flex-wrap gap-4 mt-4">
        <% articles.forEach(article => {%> <%- include('card', {article, res,
        readonly:true }); %> <% }) %> <% } %>
      </div>
    </div>
  </body>
</html>
