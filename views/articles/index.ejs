<!DOCTYPE html>
<html lang="en">
  <head><%- include('../components/head') %> 
    <title>Articles</title>
  </head>
  <body>
    <div class="container">
      <%- include('../components/header') %>
      <h1 class="mb-4">Articles List</h1>
      <!-- outside div -->
      <div class="d-flex flex-column flex-md-row gap-2">
        <!-- section1 div -->
        <div class="d-flex justify-content-start gap-2">
          <div>
            <% if(res.loggedIn) {%>
            <a
              href="/articles?filter=published"
              class="btn btn-secondary btn-sm"
              >Published</a
            >
            <% } %>
          </div>
          <div>
            <% if(res.loggedIn) {%>
            <a href="/articles/?filter=user_id" class="btn btn-secondary btn-sm"
              >My Articles</a
            >
            <% } %>
          </div>
        </div>
        <!-- section2 div -->
        <div class="d-flex justify-content-start gap-2">
          <div>
            <% if(res.loggedIn && res.member_type === "admin") {%>
            <a href="/articles/?filter=pending" class="btn btn-secondary btn-sm"
              >Pending</a
            >
            <% } %>
          </div>          <div>
            <% if(res.loggedIn && (res.member_type === "member" ||
            res.member_type === "admin")) {%>
            <a href="/articles/new" class="btn btn-primary btn-sm"
              >Add New</a
            >
            <% } %>
          </div>
        </div>
      </div>
      <% if (articles.length === 0) {%>
      <h4 class="mt-4"><%=none_msg%></h4>
      <% } else { %>
      <div class="d-flex flex-wrap gap-4 mt-4">
        <% articles.forEach(article => {%> <%- include('card', {article, res,
        readonly:false }); %> <% }) %> 
      <% } %>
    </div>
  </body>
</html>
