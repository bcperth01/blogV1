<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <title>Articles</title>
  </head>
  <body>
    <div class="container">
      <%- include('../components/header') %>
      <h1 class="mb-4">Articles List</h1>
      <!-- outside div -->
      <div class="d-flex flex-column flex-md-row gap-2">
        <!-- section1 div -->
        <div class="d-flex justify-content-start gap-2">
          <div>
            <a
              href="/articles?filter=published"
              class="btn btn-secondary btn-sm"
              >All Published</a
            >
          </div>
          <div>
            <% if(!res.loggedIn || res.loggedIn && ((res.member_type ===
            "member" || res.member_type === "admin"))) {%>
            <a href="/articles/?filter=user_id" class="btn btn-secondary btn-sm"
              >My Articles</a
            >
            <% } %>
          </div>
          <div>
            <% if(res.loggedIn && (res.member_type === "member" ||
            res.member_type === "admin")) {%>
            <a href="/articles/new" class="btn btn-primary btn-sm"
              >Add New Article</a
            >
            <% } %>
          </div>
        </div>
        <!-- section2 div -->
        <div class="d-flex justify-content-start gap-2">
          <div>
            <% if(res.loggedIn && res.member_type === "admin") {%>
            <a href="/articles/?filter=pages" class="btn btn-secondary btn-sm"
              >Page Articles</a
            >
            <% } %>
          </div>
          <div>
            <% if(res.loggedIn && res.member_type === "admin") {%>
            <a href="/articles/?filter=pending" class="btn btn-secondary btn-sm"
              >Pending Articles</a
            >
            <% } %>
          </div>
        </div>
      </div>
      <% if (articles.length === 0) {%>
      <h4 class="mt-4"><%=none_msg%></h4>
      <% } else { %>
      <div class="d-flex flex-wrap gap-4 mt-4">
        <% articles.forEach(article => {%>
        <div class="card" style="width: 400px">
          <div class="card-body">
            <div class="card-text" style="font-size: 0.8rem">
              <span class="mr-1 fw-bold">Pub:</span>
              <span><%=article.created_at.toDateString() %></span>
              <span class="mr-1m fw-bold">By:</span>
              <span><%=res.username%></span>
            </div>
            <div class="card-text" style="font-size: 0.8rem">
              <span class="mr-1 fw-bold">Views:</span>
              <span>1,000,000</span>
              <span class="mr-1m fw-bold">likes:</span>
              <span>900,000</span>
            </div>
            <h6 class="card-title mt-2"><%=article.title %></h6>
            <div class="card-text mb-2"><%=article.description %></div>
            <a
              href="/articles/<%= article.slug%>"
              class="btn btn-secondary btn-sm"
              >Read....
            </a>
            <% if(res.loggedIn && (res.id === article.user_id || res.member_type
            === "admin")) {%>
            <a
              href="/articles/edit/<%= article.slug %>"
              class="btn btn-primary btn-sm"
            >
              Edit
            </a>
            <% } %> <% if(res.loggedIn && (res.id === article.user_id ||
            res.member_type === "admin")) {%>
            <form
              action="/articles/<%= article.id %>?_method=DELETE"
              method="POST"
              class="d-inline"
            >
              <button type="submit" class="btn btn-danger btn-sm">
                Delete
              </button>
            </form>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </body>
</html>
