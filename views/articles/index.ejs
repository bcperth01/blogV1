<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../components/head') %>
    <title>Articles</title>
  </head>
  <body>
    <div class="container">
      <%- include('../components/header') %>
      <!-- outside div -->
      <div class="d-flex flex-column flex-md-row gap-2 mt-2">
        <!-- section1 div -->
        <div class="d-flex justify-content-start gap-2">
          <div>
            <% if(res.loggedIn) {%>
            <a
              href="/articles?filter=published"
              class="btn btn-secondary btn-sm"
              >Published</a
            >
            <% } %>
          </div>
          <div>
            <% if(res.loggedIn) {%>
            <a href="/articles/?filter=user_id" class="btn btn-secondary btn-sm"
              >My Articles</a
            >
            <% } %>
          </div>
        </div>
        <!-- section2 div -->
        <div class="d-flex justify-content-start gap-2">
          <div>
            <% if(res.loggedIn && res.member_type === "admin") {%>
            <a href="/articles/?filter=pending" class="btn btn-secondary btn-sm"
              >Pending</a
            >
            <% } %>
          </div>
          <div>
            <% if(res.loggedIn && (res.member_type === "member" ||
            res.member_type === "admin")) {%>
            <a href="/articles/new" class="btn btn-primary btn-sm">Add New</a>
            <% } %>
          </div>
        </div>
      </div>
      <% if (articles.length === 0) {%>
      <h4 class="mt-4"><%=none_msg%></h4>
      <% } else { %>
      <div class="d-flex flex-wrap gap-2 mt-2">
        <% articles.forEach(a => { %>
        <div class="article-card-wrapper">
          <div class="card h-100 shadow-sm">
            <!-- Image -->
            <img
              src="<%= a.imageUrl %>"
              alt="<%= a.title %>"
              class="card-img-top"
              style="
                height: 220px;
                object-fit: fill;
                background: #f8f9fa;
                padding: 10px;
              "
            />

            <!-- Body -->
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= a.title %></h5>

              <!-- 3-line truncated description -->
              <p class="card-text text-muted mb-3 description-ellipsis">
                <%= a.description %>
              </p>

              <!-- Metadata at bottom -->
              <div class="mt-auto text-secondary small">
                <!-- Author -->
                <p class="mb-1">
                  <i class="bi bi-person me-1"></i>
                  <strong>Author:</strong> <%= a.author %>
                </p>

                <!-- Published -->
                <p class="mb-1">
                  <i class="bi bi-calendar me-1"></i>
                  <strong>Published:</strong>
                  <%= a.created_at.toLocaleDateString() %>
                </p>

                <!-- Views + Likes -->
                <p class="mb-0">
                  <i class="bi bi-eye me-1"></i>
                  <strong><%= a.views %></strong>

                  &nbsp;&nbsp;

                  <i class="bi bi-hand-thumbs-up me-1"></i>
                  <strong><%= a.likes %></strong>
                </p>
              </div>
            </div>

            <!-- Footer -->
            <div class="card-footer bg-white d-flex justify-content-between">
              <a href="/articles/<%= a.slug %>" class="text-decoration-none">
                Read more →
              </a>

              <div class="d-flex gap-3">
                <a
                  href="/articles/edit/<%= a.slug %>"
                  class="text-primary text-decoration-none"
                  >Edit</a
                >
                <a
                  href="/articles/delete/<%= a.slug %>"
                  class="text-danger text-decoration-none"
                  onclick="return confirm('Delete this article?');"
                  >Delete</a
                >
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </body>
</html>
