<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../components/head') %>
    <title>Articles</title>
  </head>
  <body>
    <div class="container">
      <%- include('../components/header') %>
      <h1 class="mb-4">Articles List</h1>
      <!-- outside div -->
      <div class="d-flex flex-column flex-md-row gap-2">
        <!-- section1 div -->
        <div class="d-flex justify-content-start gap-2">
          <div>
            <% if(res.loggedIn) {%>
            <a
              href="/articles?filter=published"
              class="btn btn-secondary btn-sm"
              >Published</a
            >
            <% } %>
          </div>
          <div>
            <% if(res.loggedIn) {%>
            <a href="/articles/?filter=user_id" class="btn btn-secondary btn-sm"
              >My Articles</a
            >
            <% } %>
          </div>
        </div>
        <!-- section2 div -->
        <div class="d-flex justify-content-start gap-2">
          <div>
            <% if(res.loggedIn && res.member_type === "admin") {%>
            <a href="/articles/?filter=pending" class="btn btn-secondary btn-sm"
              >Pending</a
            >
            <% } %>
          </div>
          <div>
            <% if(res.loggedIn && (res.member_type === "member" ||
            res.member_type === "admin")) {%>
            <a href="/articles/new" class="btn btn-primary btn-sm">Add New</a>
            <% } %>
          </div>
        </div>
      </div>
      <% if (articles.length === 0) {%>
      <h4 class="mt-4"><%=none_msg%></h4>
      <% } else { %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4 mt-4">
        <% articles.forEach(article => { %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm">
            <!-- Image -->
            <img
              src="<%= article.imageUrl %>"
              alt="<%= article.title %>"
              class="card-img-top"
              style="
                height: 220px;
                object-fit: contain;
                background: #f8f9fa;
                padding: 10px;
              "
            />

            <!-- Body -->
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= article.title %></h5>

              <p class="card-text text-muted mb-3">
                <%= article.description %>
              </p>

              <!-- Push metadata to bottom -->
              <div class="mt-auto text-secondary small">
                <!-- Author (own line) -->
                <p class="mb-1">
                  <strong>Author:</strong> <%= article.author %>
                </p>

                <!-- Published (own line) -->
                <p class="mb-1">
                  <strong>Published:</strong>
                  <%= article.created_at.toLocaleDateString() %>
                </p>

                <!-- Views + Likes (you can separate if you prefer) -->
                <p class="mb-0">
                  <strong>Views:</strong> <%= article.views %> &nbsp;|&nbsp;
                  <strong>Likes:</strong> <%= article.likes %>
                </p>
              </div>
            </div>

            <!-- Footer -->
            <div class="card-footer bg-white d-flex justify-content-between">
              <a
                href="/articles/<%= article.slug%>"
                class="text-decoration-none"
              >
                Read more →
              </a>

              <div class="d-flex gap-3">
                <a
                  href="/articles/edit/<%= article.slug %>"
                  class="text-primary text-decoration-none"
                  >Edit</a
                >
                <a
                  href="/articles/delete/<%= article.slug %>"
                  class="text-danger text-decoration-none"
                  onclick="return confirm('Delete this article?');"
                  >Delete</a
                >
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </body>
</html>
