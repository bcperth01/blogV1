<!-- container for users Table -->
<div class="container">
  <table class="table table-striped table-hover">
    <tr>
      <th>#</th>
      <th>id</th>
      <th>username</th>
      <th>first_name</th>
      <th>last_name</th>
      <th>email</th>
      <th>member_type</th>
      <th>Actions</th>
    </tr>
    <% users.forEach(function(user,index){%>
    <tr>
      <td><%=index+1%></td>
      <td><%=user.id%></td>
      <td><%=user.username%></td>
      <td><%=user.first_name%></td>
      <td><%=user.last_name%></td>
      <td><%=user.email%></td>
      <td><%=user.member_type%></td>
      <td>
        <a href="/auth/edit?id=<%=user.id%>" class="btn btn-dark">
          <i class="bi bi-pencil"></i>
        </a>
        <a
          href="/auth/delete?id=<%=user.id%>&username=<%=user.username%>"
          class="btn btn-danger"
        >
          <i class="bi bi-trash"></i>
        </a>
      </td>
    </tr>
    <% }) %>
  </table>
</div>
