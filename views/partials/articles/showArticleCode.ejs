<input type="hidden" id="filePath" name="path" value="<%= path %>" />
<h1 class="mb-1"><%= article.title %></h1>
<div><%-article.sanitisedHtml%></div>
<!-- Delete (Article) Confirmation Modal -->
<%- include('../../partials/deleteArticleModal') %>

<script src="https://unpkg.com/panzoom@9.4.3/dist/panzoom.min.js"></script>

<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
  <!-- Extra large on desktop, fullscreen on small devices -->
  <div class="modal-dialog modal-xl modal-fullscreen-sm-down">
    <div class="modal-content bg-dark border-0">
      <button
        type="button"
        class="btn-close btn-close-white ms-auto me-3 mt-3"
        data-bs-dismiss="modal"
      ></button>

      <!-- Flex container to center image -->
      <div
        id="zoomContainer"
        class="modal-body d-flex justify-content-center align-items-center p-0"
        style="overflow: hidden; min-height: 60vh"
      >
        <img
          id="modalImage"
          class="img-fluid"
          style="cursor: grab; max-width: 100%; max-height: 100%"
        />
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    let panzoomInstance;

    const modalEl = document.getElementById("imageModal");
    const modalImg = document.getElementById("modalImage");
    const zoomContainer = document.getElementById("zoomContainer");

    function disposePanzoom() {
      if (panzoomInstance) {
        try {
          if (zoomContainer && panzoomInstance)
            zoomContainer.removeEventListener(
              "wheel",
              panzoomInstance.zoomWithWheel
            );
          panzoomInstance.dispose?.();
        } catch (err) {
          console.warn("Error disposing panzoom instance:", err);
        }
        panzoomInstance = null;
      }
    }

    async function openModalWithImage(url) {
      disposePanzoom();

      modalImg.src = url.replace(/&amp;/g, "&");
      const bsModal = new bootstrap.Modal(modalEl);
      bsModal.show();

      modalImg.onload = () => {
        disposePanzoom();

        // ✅ Use lowercase 'panzoom' global
        panzoomInstance = panzoom(modalImg, {
          maxScale: 5,
          minScale: 1,
        });

        // wheel zoom
        if (zoomContainer) {
          zoomContainer.addEventListener(
            "wheel",
            panzoomInstance.zoomWithWheel,
            { passive: false }
          );
        }

        modalImg.style.cursor = "grab";
      };
    }

    document.querySelectorAll("img[data-full]").forEach((img) => {
      img.style.cursor = "zoom-in";

      img.addEventListener("click", () => {
        const fullUrl = img.dataset.full.replace(/&amp;/g, "&");
        openModalWithImage(fullUrl);
      });
    });

    modalEl.addEventListener("hidden.bs.modal", () => {
      disposePanzoom();
      modalImg.src = "";
    });
  });
</script>
